{{#if notes.length}}
  <ul class="tta-note-list">
    {{#each notes}}
      <li class="tta-note {{#if isGMNote}}tta-note-gm{{/if}}">
        <div class="tta-note-body">
          <div class="tta-note-title">{{title}}</div>

          <div class="tta-note-meta">
            <span class="tta-tag {{#if isGMNote}}tta-tag-accent{{/if}}">{{authorName}}</span>
            <span class="tta-meta">{{visibilityLabel}}</span>
            {{#if promoted}}
              <span class="tta-tag tta-tag-outline" data-tooltip="{{localize "TTA.Notes.PromotedTooltip"}}">{{localize "TTA.Notes.Promoted"}}</span>
            {{/if}}
          </div>

          {{#if enriched}}<div class="tta-note-content">{{{enriched}}}</div>{{/if}}
        </div>

        <span class="tta-note-actions">
          {{#if ../canPromote}}
            {{#unless promoted}}
              <button type="button" class="tta-ghost tta-compact" data-action="promoteNote" data-uuid="{{uuid}}">{{localize "TTA.Notes.PromoteShort"}}</button>
            {{/unless}}
          {{/if}}
          <span class="tta-row">
            <button type="button" class="tta-icon-only" data-action="openJournal" data-uuid="{{uuid}}"
                    data-tooltip="{{localize "TTA.Notes.OpenJournal"}}" aria-label="{{localize "TTA.Notes.OpenJournal"}}">
              <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            </button>
            {{#if canEdit}}
              <button type="button" class="tta-icon-only" data-action="editNote" data-uuid="{{uuid}}"
                      data-tooltip="{{localize "TTA.Common.Edit"}}" aria-label="{{localize "TTA.Common.Edit"}}">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
              </button>
            {{/if}}
            {{#if canDelete}}
              <button type="button" class="tta-icon-only tta-danger" data-action="deleteNote" data-uuid="{{uuid}}"
                      data-tooltip="{{localize "TTA.Common.Delete"}}" aria-label="{{localize "TTA.Common.Delete"}}">
                <i class="fa-solid fa-trash" aria-hidden="true"></i>
              </button>
            {{/if}}
          </span>
        </span>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="tta-empty">{{emptyLabel}}</p>
{{/if}}
