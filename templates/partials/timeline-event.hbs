<li class="tta-timeline-event" style="--tta-accent: {{color}}">
  <span class="tta-event-icon" aria-hidden="true"><i class="{{icon}}"></i></span>

  <div class="tta-event-body">
    <header class="tta-event-header">
      <h5 class="tta-event-title">{{title}}</h5>
      <span class="tta-event-date">{{dateLabel}}</span>
    </header>

    <p class="tta-event-badges">
      <span class="tta-badge tta-badge-{{visibility}}">
        <i class="fa-solid {{#if isPlayerVisible}}fa-eye{{else}}fa-lock{{/if}}" aria-hidden="true"></i>
        {{visibilityLabel}}
      </span>
      {{#if showOrigin}}
        <span class="tta-badge tta-badge-origin" data-tooltip="{{localize "TTA.Timeline.OriginTooltip"}}">
          <i class="fa-solid fa-arrow-up-right-dots" aria-hidden="true"></i>
          {{localize "TTA.Timeline.Origin"}}
        </span>
      {{/if}}
    </p>

    {{#if enriched}}<div class="tta-event-content">{{{enriched}}}</div>{{/if}}

    {{#if @root.canManage}}
      <footer class="tta-event-actions">
        <button type="button" data-action="editEvent" data-event-id="{{id}}">
          <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> {{localize "TTA.Common.Edit"}}
        </button>
        {{#if showOrigin}}
          {{#if sourceAvailable}}
            <button type="button" data-action="openSource" data-uuid="{{sourceUuid}}">
              <i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "TTA.Timeline.OpenSource"}}
            </button>
          {{else}}
            <span class="tta-muted tta-source-missing">{{localize "TTA.Timeline.SourceUnavailable"}}</span>
          {{/if}}
        {{/if}}
        <button type="button" class="tta-danger" data-action="deleteEvent" data-event-id="{{id}}">
          <i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "TTA.Common.Delete"}}
        </button>
      </footer>
    {{/if}}
  </div>
</li>
