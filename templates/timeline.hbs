<section class="tta-layout tta-timeline-layout">

  <div class="tta-mode-bar">
    <div class="tta-pill-group" role="group" aria-label="{{localize "TTA.Timeline.ModeLabel"}}">
      {{#each modes}}
        <button type="button"
                data-action="setMode"
                data-mode="{{value}}"
                class="tta-pill {{#if active}}tta-pill-active{{/if}}"
                aria-pressed="{{#if active}}true{{else}}false{{/if}}"
                {{#unless @root.isGM}}disabled data-tooltip="{{localize "TTA.Errors.ModeGMOnly"}}"{{/unless}}>
          {{label}}
        </button>
      {{/each}}
    </div>
    {{#unless isGM}}
      <span class="tta-meta">{{localize "TTA.Timeline.ModeSetByGM"}}</span>
    {{/unless}}
  </div>

  <header class="tta-timeline-toolbar">
    <button type="button" class="tta-step" data-action="prev"
            data-tooltip="{{localize "TTA.Timeline.Previous"}}" aria-label="{{localize "TTA.Timeline.Previous"}}">&lsaquo;</button>
    <button type="button" class="tta-step" data-action="next"
            data-tooltip="{{localize "TTA.Timeline.Next"}}" aria-label="{{localize "TTA.Timeline.Next"}}">&rsaquo;</button>
    <button type="button" class="tta-compact" data-action="gotoCurrent">{{localize "TTA.Calendar.Today"}}</button>

    <span class="tta-timeline-scope">{{scopeLabel}}</span>

    <select class="tta-compact" data-filter-select aria-label="{{localize "TTA.Filters.Label"}}">
      {{#each filterChoices}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>

    {{#if canManage}}
      <button type="button" class="tta-ghost tta-compact" data-action="addEvent">{{localize "TTA.Timeline.AddEvent"}}</button>
      <button type="button" class="tta-ghost tta-compact" data-action="promoteFromNote">{{localize "TTA.Timeline.FromNote"}}</button>
    {{/if}}
  </header>

  <div class="tta-timeline-body">

    {{#if bands.length}}
      {{!-- Each band takes a share of the row proportional to its duration,
            floored so a short Age never collapses to a sliver. --}}
      <ul class="tta-bands">
        {{#each bands}}
          <li style="--tta-band-flex: {{flex}}; --tta-tint: {{color}}">
            <button type="button" class="tta-band {{#if isViewed}}tta-band-active{{/if}}"
                    data-action="gotoAge" data-year="{{startYear}}" style="--tta-tint: {{color}}">
              <span class="tta-kicker">{{#if isCurrent}}{{localize "TTA.Timeline.CurrentAge"}}{{else}}{{localize "TTA.Ages.Age"}}{{/if}}</span>
              <span class="tta-band-name">{{name}}</span>
              <span class="tta-band-sub tta-num">{{startYear}}&ndash;{{endYear}} &middot; {{yearCount}} {{localize "TTA.Ages.YearCount"}}</span>
            </button>
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if ticks.length}}
      <div class="tta-spine" aria-hidden="true">
        {{#each ticks}}
          <div class="tta-tick {{#if isCurrent}}tta-tick-current{{/if}} {{#if hasEvent}}tta-tick-event{{/if}}"
               style="--tta-tick-pos: {{position}}%">
            <span class="tta-tick-mark"></span>
            <span class="tta-tick-label">{{label}}</span>
          </div>
        {{/each}}
      </div>
    {{/if}}

    <div class="tta-events-head">
      <span class="tta-kicker">{{localize "TTA.Timeline.EventsHeading"}}</span>
      <span class="tta-meta">{{localize "TTA.Timeline.EventCount"}}: <span class="tta-num">{{eventCount}}</span></span>
    </div>

    {{#if isEmpty}}
      <p class="tta-empty">{{localize "TTA.Timeline.NoEvents"}}</p>
    {{else}}
      <ol class="tta-year-list">
        {{#each groups}}
          <li class="tta-year {{#if isCurrent}}tta-year-current{{/if}}">
            <div class="tta-year-gutter">{{year}}</div>
            <ul class="tta-year-events">
              {{#each events}}
                {{> "modules/through-the-ages/templates/partials/timeline-event.hbs"}}
              {{/each}}
            </ul>
          </li>
        {{/each}}
      </ol>
    {{/if}}
  </div>

  <footer class="tta-footer">
    <span>{{localize "TTA.Timeline.BrowsingFooter"}}</span>
    <span class="tta-num">{{currentDateLabel}}</span>
  </footer>
</section>
