<div class="tta-config-part">
<div class="tta-config-body">

  {{#if errors.length}}
    <div class="tta-banner tta-banner-error" role="alert">
      <h4><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> {{localize "TTA.Config.ErrorsHeading"}}</h4>
      <ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
    </div>
  {{/if}}

  {{#if warnings.length}}
    <div class="tta-banner tta-banner-warning">
      <h4><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "TTA.Config.WarningsHeading"}}</h4>
      <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
    </div>
  {{/if}}

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Config.StructureHeading"}}</legend>
    <p class="tta-hint">{{localize "TTA.Config.StructureHint"}}</p>

    <div class="tta-field-row">
      <label for="tta-months">{{localize "TTA.Config.MonthsPerYear"}}</label>
      <input id="tta-months" type="number" name="monthsPerYear" data-structure
             min="{{limits.MONTHS_MIN}}" max="{{limits.MONTHS_MAX}}" step="1" value="{{calendar.monthsPerYear}}">
    </div>

    <div class="tta-field-row">
      <label for="tta-days">{{localize "TTA.Config.DaysPerMonth"}}</label>
      <input id="tta-days" type="number" name="daysPerMonth" data-structure
             min="{{limits.DAYS_MIN}}" max="{{limits.DAYS_MAX}}" step="1" value="{{calendar.daysPerMonth}}">
    </div>

    <div class="tta-field-row">
      <label for="tta-weekdays">{{localize "TTA.Config.WeekdayCount"}}</label>
      <input id="tta-weekdays" type="number" name="weekdayCount" data-structure
             min="{{limits.WEEKDAYS_MIN}}" max="{{limits.WEEKDAYS_MAX}}" step="1" value="{{weekdayCount}}">
    </div>
  </fieldset>

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Config.MonthNames"}}</legend>
    <div class="tta-name-grid">
      {{#each monthNames}}
        <label class="tta-name-field">
          <span class="tta-name-index">{{number}}</span>
          <input type="text" data-month-name value="{{name}}"
                 aria-label="{{localize "TTA.Config.MonthNameAria"}} {{number}}">
        </label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Config.WeekdayNames"}}</legend>
    <div class="tta-name-grid">
      {{#each weekdayNames}}
        <label class="tta-name-field">
          <span class="tta-name-index">{{number}}</span>
          <input type="text" data-weekday-name value="{{name}}"
                 aria-label="{{localize "TTA.Config.WeekdayNameAria"}} {{number}}">
        </label>
      {{/each}}
    </div>
    <button type="button" class="tta-secondary" data-action="resetNames">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "TTA.Config.ResetNames"}}
    </button>
  </fieldset>

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Moons.Heading"}}</legend>
    <p class="tta-hint">{{localize "TTA.Moons.Hint"}}</p>

    {{#if hasMoons}}
      <ol class="tta-moon-editor">
        {{#each moons}}
          <li class="tta-moon-row" data-moon-row data-moon-id="{{id}}" style="--tta-accent: {{color}}">
            <div class="tta-moon-main">
              <span class="tta-moon-preview" aria-hidden="true">
                <span class="tta-moon-disc {{#if waxing}}tta-waxing{{else}}tta-waning{{/if}} {{#if gibbous}}tta-gibbous{{/if}}"
                      style="--tta-moon-color: {{color}}; --tta-illumination: {{illumination}}; --tta-terminator: {{terminator}}"></span>
              </span>
              <label class="tta-grow">
                <span>{{localize "TTA.Moons.Name"}}</span>
                <input type="text" data-field="name" value="{{name}}">
              </label>
              <label>
                <span>{{localize "TTA.Moons.CycleLength"}}</span>
                <input type="number" data-field="cycleLength" min="2" max="1000" step="1" value="{{cycleLength}}">
              </label>
              <label>
                <span>{{localize "TTA.Moons.Offset"}}</span>
                <input type="number" data-field="offset" min="0" step="1" value="{{offset}}">
              </label>
              <label>
                <span>{{localize "TTA.Moons.PhaseCount"}}</span>
                <select data-field="phaseCount">
                  {{#each phaseChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="tta-color">
                <span>{{localize "TTA.Moons.Color"}}</span>
                <input type="color" data-field="color" value="{{color}}">
              </label>
            </div>

            <div class="tta-moon-footer">
              <p class="tta-moon-phase-label">
                <span>{{localize "TTA.Moons.PhaseToday"}}</span>
                <strong>{{phaseLabel}}</strong>
              </p>
              <label class="tta-checkbox">
                <input type="checkbox" data-field="showInGrid" {{#if showInGrid}}checked{{/if}}>
                <span>{{localize "TTA.Moons.ShowInGrid"}}</span>
              </label>
              <label class="tta-checkbox">
                <input type="checkbox" data-field="playerVisible" {{#if playerVisible}}checked{{/if}}>
                <span>{{localize "TTA.Moons.PlayerVisible"}}</span>
              </label>
              <span class="tta-moon-controls">
                <button type="button" data-action="moveMoonUp" data-tooltip="{{localize "TTA.Common.MoveUp"}}" aria-label="{{localize "TTA.Common.MoveUp"}}">
                  <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="moveMoonDown" data-tooltip="{{localize "TTA.Common.MoveDown"}}" aria-label="{{localize "TTA.Common.MoveDown"}}">
                  <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-danger" data-action="removeMoon">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "TTA.Common.Remove"}}
                </button>
              </span>
            </div>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="tta-empty">{{localize "TTA.Moons.NoMoons"}}</p>
    {{/if}}

    {{#if canAddMoon}}
      <button type="button" class="tta-secondary" data-action="addMoon">
        <i class="fa-solid fa-moon" aria-hidden="true"></i> {{localize "TTA.Moons.AddMoon"}}
      </button>
    {{else}}
      <p class="tta-hint">{{localize "TTA.Moons.LimitHint" max=moonsMax}}</p>
    {{/if}}
  </fieldset>

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Config.CurrentDateHeading"}}</legend>
    <div class="tta-field-row">
      <label for="tta-current-year">{{localize "TTA.Common.Year"}}</label>
      <input id="tta-current-year" type="number" name="currentYear" min="{{limits.YEAR_MIN}}" step="1" value="{{calendar.currentDate.year}}">
    </div>
    <div class="tta-field-row">
      <label for="tta-current-month">{{localize "TTA.Common.Month"}}</label>
      <select id="tta-current-month" name="currentMonth">
        {{#each monthChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="tta-field-row">
      <label for="tta-current-day">{{localize "TTA.Common.Day"}}</label>
      <input id="tta-current-day" type="number" name="currentDay" min="1" max="{{calendar.daysPerMonth}}" step="1" value="{{calendar.currentDate.day}}">
    </div>
  </fieldset>

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Config.AgesHeading"}}</legend>
    <p class="tta-hint">{{localize "TTA.Config.AgesHint"}}</p>

    {{#if hasAges}}
      <ol class="tta-age-editor">
        {{#each ages}}
          <li class="tta-age-row" data-age-row data-age-id="{{id}}" style="--tta-accent: {{color}}">
            <div class="tta-age-main">
              <label class="tta-grow">
                <span>{{localize "TTA.Ages.Name"}}</span>
                <input type="text" data-field="name" value="{{name}}">
              </label>
              <label>
                <span>{{localize "TTA.Ages.StartYear"}}</span>
                <input type="number" data-field="startYear" min="1" step="1" value="{{startYear}}">
              </label>
              <label>
                <span>{{localize "TTA.Ages.Duration"}}</span>
                <input type="number" data-field="durationYears" min="1" step="1" value="{{durationYears}}">
              </label>
              <p class="tta-age-endyear">
                <span>{{localize "TTA.Ages.EndYear"}}</span>
                <strong>{{endYear}}</strong>
              </p>
              <label class="tta-color">
                <span>{{localize "TTA.Ages.Color"}}</span>
                <input type="color" data-field="color" value="{{color}}">
              </label>
            </div>

            <label class="tta-age-description">
              <span>{{localize "TTA.Ages.Description"}}</span>
              <textarea data-field="description" rows="2">{{description}}</textarea>
            </label>

            <div class="tta-age-footer">
              <label class="tta-checkbox">
                <input type="checkbox" data-field="playerVisible" {{#if playerVisible}}checked{{/if}}>
                <span>{{localize "TTA.Ages.PlayerVisible"}}</span>
              </label>
              <span class="tta-age-controls">
                <button type="button" data-action="moveAgeUp" data-tooltip="{{localize "TTA.Common.MoveUp"}}" aria-label="{{localize "TTA.Common.MoveUp"}}">
                  <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="moveAgeDown" data-tooltip="{{localize "TTA.Common.MoveDown"}}" aria-label="{{localize "TTA.Common.MoveDown"}}">
                  <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" class="tta-danger" data-action="removeAge">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "TTA.Common.Remove"}}
                </button>
              </span>
            </div>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="tta-empty">{{localize "TTA.Config.NoAges"}}</p>
    {{/if}}

    <button type="button" class="tta-secondary" data-action="addAge">
      <i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "TTA.Config.AddAge"}}
    </button>
  </fieldset>

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Config.StorageHeading"}}</legend>
    <p class="tta-hint">
      {{#if folderName}}
        {{localize "TTA.Config.FolderLinked"}} <strong>{{folderName}}</strong>
      {{else}}
        {{localize "TTA.Config.FolderMissing"}}
      {{/if}}
    </p>
    <button type="button" class="tta-secondary" data-action="repairFolder">
      <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> {{localize "TTA.Config.RepairFolder"}}
    </button>
  </fieldset>

  <fieldset class="tta-fieldset">
    <legend>{{localize "TTA.Import.Heading"}}</legend>
    <p class="tta-hint">{{localize "TTA.Import.Hint"}}</p>

    {{#if hasPendingImport}}
      <p class="tta-banner tta-banner-warning">
        <i class="fa-solid fa-file-import" aria-hidden="true"></i>
        {{localize "TTA.Import.PendingEvents"}} ({{pendingEventCount}})
        <button type="button" data-action="discardImport">{{localize "TTA.Import.DiscardEvents"}}</button>
      </p>
    {{/if}}

    <label class="tta-checkbox">
      <input type="checkbox" data-export-events checked>
      <span>{{localize "TTA.Import.IncludeEvents"}}</span>
    </label>

    <div class="tta-button-row">
      <button type="button" class="tta-secondary" data-action="exportCalendar">
        <i class="fa-solid fa-file-export" aria-hidden="true"></i> {{localize "TTA.Import.Export"}}
      </button>
      <button type="button" class="tta-secondary" data-action="importCalendar">
        <i class="fa-solid fa-file-import" aria-hidden="true"></i> {{localize "TTA.Import.Import"}}
      </button>
    </div>
  </fieldset>
</div>

<footer class="tta-form-footer">
  <button type="submit" class="tta-primary">
    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "TTA.Config.Save"}}
  </button>
</footer>
</div>
